.ai-work/

# Vercel Skills CLI — third-party agent skills (restore via skills-lock.json locally)
.agents/
skills-lock.json

# Claude Code local settings
.claude/settings.local.json
.claude/*.local.md
.claude/*.local.json

# Praxion seeds this rule-disable template into every project it is active in
# (SessionStart hook `inject_rules.py::_ensure_template_present`, and again in
# `/onboard-project`). Both are create-if-absent, so deleting it just brings it
# back next session. It is a reference template, never read -- the hook reads
# `.claude/praxion-rules.yaml`, without the suffix. Ignored rather than
# committed: it is upstream's file, upstream edits it, and the seeder never
# refreshes an existing copy, so a committed one would silently go stale.
.claude/praxion-rules.yaml.example

# Dispatch-telemetry JSONL sink. Its default home is outside every repo (the
# sink is opt-in via KNOTICA_TELEMETRY_DIR and tool routing is not vault data),
# but a relative override pointed here while the server runs with this repo as
# its working directory would otherwise land in the index.
#
# ANCHORED to the repo root on purpose. Unanchored, `.knotica/` matches at every
# depth and would silently shadow `vault-template/.knotica/` -- which IS
# committed and carries the four seed prompts. An existing tracked file survives
# that, but the next one added there would vanish without a word.
/.knotica/

# OS
.DS_Store

# Local credentials (discovery API keys) — never commit
.env

# Claude Code worktrees live here -- full repo copies, never committed.
.claude/worktrees/

# AI assistants
.ai-work/
.ai-state/*.lock
.ai-state/**/*.lock
.ai-state/*.backup.json
.ai-state/observations.jsonl.1
.claude/settings.local.json
.claude/worktrees/
.env
.env.*
.env.local
