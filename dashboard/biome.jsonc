{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",

  // Biome is the dashboard's ruff: one binary for lint + format, covering the
  // TypeScript/CSS half of `make verify` the way `ruff check` and
  // `ruff format --check` already cover the Python half.
  //
  // Everything below CODIFIES what this tree already does. Each value was
  // measured against `src/`, not imported from a house style elsewhere. Do not
  // swap one for a fashionable default without re-measuring the churn it makes.

  "files": {
    // `dist/` is build output. `src/processModel.ts` is GENERATED by
    // `scripts/generate_process_model_ts.py` and gated by a
    // `git diff --exit-code` in `make verify` -- a generated file is not
    // style-governed, and formatting it here would leave the generator's own
    // output permanently dirty against its gate.
    "includes": ["**", "!**/dist", "!src/processModel.ts"]
  },

  "formatter": {
    // lineWidth 80 is measured, not assumed. Reformatting `src/` at widths
    // 70 / 76 / 80 / 84 / 90 / 100 / 120 changed
    // 10371 / 6770 / 4597 / 4925 / 5558 / 6689 / 8657 lines respectively:
    // 80 is the minimum, because the tree was already hand-wrapped there.
    // It is also Biome's own default, so the two agree.
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },

  "javascript": {
    "formatter": {
      // Measured over `src/`: ~9.5k double-quoted string literals against
      // ~140 single-quoted, and ~9.3k semicolon-terminated lines.
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },

  // Import order here is AUTHORED, not alphabetical: framework imports, a
  // blank line, then locals grouped by origin (shared root primitives, then
  // lane-local). Biome's organize-imports assist collapses that blank-line
  // group separator and re-sorts by specifier -- 46 files of churn that
  // prevents no defect and erases a real convention.
  "assist": {
    "actions": { "source": { "organizeImports": "off" } }
  },

  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",

      // The five rules below are the whole disable list, each triaged against
      // its real findings rather than switched off to make the gate green.
      "a11y": {
        // Insists a `role="group"` container become a `<fieldset>`. Wrong for
        // the queue's filter/outcome chip rows and the prompt-diff panels:
        // none is a form control group, and `<fieldset>` drags legend
        // semantics and UA styling in with it. `role="group"` on a div is
        // correct ARIA. The rest of the a11y group stays ON and is
        // load-bearing here -- three genuine `aria-label`-ignored-by-role
        // findings were fixed rather than suppressed when this landed.
        "useSemanticElements": "off"
      },
      "complexity": {
        // 8 findings, all in `app.css`, all deliberate overrides: uPlot writes
        // an inline `width` that only `!important` can beat, and the
        // `.heal-freeze-*` rules override base `button` styling. Rewriting
        // them as specificity bumps is a cascade change, not a lint fix.
        "noImportantStyles": "off",
        // 15 findings, and the fragments are load-bearing: `SectionCard`,
        // `Stat` and friends type `children` as `string | Element`, so a
        // multi-child body MUST be wrapped. Applying the rule's own fix makes
        // `tsc --noEmit` fail in 8 files -- verified, not assumed.
        "noUselessFragments": "off"
      },
      "style": {
        // 27 findings, all in `app.css`. The rule fires whenever a
        // lower-specificity selector appears after a higher-specificity one
        // targeting the same element -- structurally unavoidable in a
        // ~1900-line stylesheet grouped by component. Satisfying it means
        // reordering the file by specificity and losing that grouping.
        "noDescendingSpecificity": "off",
        // 7 findings. `client!` sits at call sites a mount condition already
        // guards, and `document.getElementById("app")!` is the canonical
        // Preact mount. The rule's fix -- optional chaining -- would turn a
        // billed two-phase action into a silent no-op, which is worse than
        // the assertion.
        "noNonNullAssertion": "off"
      }
    }
  }
}
