{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/scripts/session_state_guard.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "env": {
    "PRAXION_DISABLE_OBSERVABILITY": "0"
  }
}
